{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${mod_description}",
  "authors": [
    "SteveKunG"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/indicatia",
    "sources": "https://github.com/SteveKunG/Indicatia",
    "issues": "https://github.com/SteveKunG/Indicatia/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.stevekung.indicatia.fabric.IndicatiaFabric"
    ],
    "modmenu": [
      "com.stevekung.indicatia.fabric.modmenu.ModMenuIntegrationIN"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": ">=0.144",
    "cloth-config": ">=26.1",
    "minecraft": "~26.1"
  },
  "mixins": [
    "mixins.indicatia.json",
    "mixins.indicatia_fabric.json"
  ],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/4bAj4mkGag"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/client/renderer/entity/state/LivingEntityRenderState": [
        "com/stevekung/indicatia/EnchantedFoilExtender"
      ],
      "net/minecraft/client/renderer/blockentity/DecoratedPotRenderer": [
        "com/stevekung/indicatia/EnchantedFoilExtender"
      ],
      "net/minecraft/client/renderer/blockentity/BedRenderer": [
        "com/stevekung/indicatia/EnchantedFoilExtender"
      ],
      "net/minecraft/client/renderer/blockentity/ShulkerBoxRenderer": [
        "com/stevekung/indicatia/EnchantedFoilExtender"
      ],
      "net/minecraft/client/renderer/blockentity/BannerRenderer": [
        "com/stevekung/indicatia/EnchantedFoilExtender"
      ]
    }
  }
}